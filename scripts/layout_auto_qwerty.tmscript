name=Layout Auto QWERTY
description=Automatically converts text between RU and EN QWERTY layouts
hotkey=Shift+Shift
enabled=true
output_layout=auto
---
[Console]::InputEncoding = [System.Text.Encoding]::UTF8
[Console]::OutputEncoding = [System.Text.Encoding]::UTF8

function AddMap([System.Collections.Generic.Dictionary[string,string]]$map, [int[]]$fromCodes, [int[]]$toCodes) {
    if ($fromCodes.Count -ne $toCodes.Count) {
        throw "Mapping arrays must have equal length."
    }
    for ($i = 0; $i -lt $fromCodes.Count; $i++) {
        $map[[string][char]$fromCodes[$i]] = [string][char]$toCodes[$i]
    }
}

$ruToEn = [System.Collections.Generic.Dictionary[string,string]]::new([System.StringComparer]::Ordinal)
$enToRu = [System.Collections.Generic.Dictionary[string,string]]::new([System.StringComparer]::Ordinal)

$ruLower = @(0x0439,0x0446,0x0443,0x043A,0x0435,0x043D,0x0433,0x0448,0x0449,0x0437,0x0445,0x044A,0x0444,0x044B,0x0432,0x0430,0x043F,0x0440,0x043E,0x043B,0x0434,0x0436,0x044D,0x044F,0x0447,0x0441,0x043C,0x0438,0x0442,0x044C,0x0431,0x044E,0x0451,0x002E)
$enLower = @(0x0071,0x0077,0x0065,0x0072,0x0074,0x0079,0x0075,0x0069,0x006F,0x0070,0x005B,0x005D,0x0061,0x0073,0x0064,0x0066,0x0067,0x0068,0x006A,0x006B,0x006C,0x003B,0x0027,0x007A,0x0078,0x0063,0x0076,0x0062,0x006E,0x006D,0x002C,0x002E,0x0060,0x002F)

$ruUpper = @(0x0419,0x0426,0x0423,0x041A,0x0415,0x041D,0x0413,0x0428,0x0429,0x0417,0x0425,0x042A,0x0424,0x042B,0x0412,0x0410,0x041F,0x0420,0x041E,0x041B,0x0414,0x0416,0x042D,0x042F,0x0427,0x0421,0x041C,0x0418,0x0422,0x042C,0x0411,0x042E,0x0401,0x002C)
$enUpper = @(0x0051,0x0057,0x0045,0x0052,0x0054,0x0059,0x0055,0x0049,0x004F,0x0050,0x007B,0x007D,0x0041,0x0053,0x0044,0x0046,0x0047,0x0048,0x004A,0x004B,0x004C,0x003A,0x0022,0x005A,0x0058,0x0043,0x0056,0x0042,0x004E,0x004D,0x003C,0x003E,0x007E,0x003F)

$ruSpecialFrom = @(0x0022,0x2116,0x003B,0x003A,0x003F,0x002F)
$ruSpecialTo   = @(0x0040,0x0023,0x0024,0x005E,0x0026,0x007C)

AddMap $ruToEn $ruLower $enLower
AddMap $ruToEn $ruUpper $enUpper
AddMap $ruToEn $ruSpecialFrom $ruSpecialTo

AddMap $enToRu $enLower $ruLower
AddMap $enToRu $enUpper $ruUpper
AddMap $enToRu $ruSpecialTo $ruSpecialFrom

$inputText = [Console]::In.ReadToEnd()

$ruScore = 0
$enScore = 0
foreach ($ch in $inputText.ToCharArray()) {
    $key = [string]$ch
    $code = [int][char]$ch

    if ($code -ge 0x0400 -and $code -le 0x04FF) {
        $ruScore += 2
    }
    if (($code -ge 0x41 -and $code -le 0x5A) -or ($code -ge 0x61 -and $code -le 0x7A)) {
        $enScore += 2
    }

    if ($ruToEn.ContainsKey($key)) {
        $ruScore += 1
    }
    if ($enToRu.ContainsKey($key)) {
        $enScore += 1
    }
}

if ($ruScore -eq 0 -and $enScore -eq 0) {
    [Console]::Out.Write($inputText)
    exit 0
}

$useRuToEn = $true
if ($ruScore -gt $enScore) {
    $useRuToEn = $true
} elseif ($enScore -gt $ruScore) {
    $useRuToEn = $false
} else {
    foreach ($ch in $inputText.ToCharArray()) {
        $code = [int][char]$ch
        if ($code -ge 0x0400 -and $code -le 0x04FF) {
            $useRuToEn = $true
            break
        }
        if (($code -ge 0x41 -and $code -le 0x5A) -or ($code -ge 0x61 -and $code -le 0x7A)) {
            $useRuToEn = $false
            break
        }
    }
}

$map = if ($useRuToEn) { $ruToEn } else { $enToRu }
$sb = [System.Text.StringBuilder]::new()

foreach ($ch in $inputText.ToCharArray()) {
    $key = [string]$ch
    if ($map.ContainsKey($key)) {
        [void]$sb.Append($map[$key])
    } else {
        [void]$sb.Append($ch)
    }
}

[Console]::Out.Write($sb.ToString())
